<edge source="1D_CNN_8bc107d1" target="1D_CNN_8bc107d1" id="memorize_finding(finding=O2/O3: Disabling batch_norm (batch_norm...)">
  <data key="d3">memorize_finding(finding=O2/O3: Disabling batch_norm (batch_norm...)</data>
  <data key="d4">2</data>
  <data key="d5">[-0.05, 0.0, 0.0, 0.0, 0.0]</data>
  <data key="d6">[[-0.05, 0.0, 0.0, 0.0, 0.0], [-0.05, 0.0, 0.0, 0.0, 0.0]]</data>
  <data key="d7">{"finding": "O2/O3: Disabling batch_norm (batch_norm=0) with weight_decay=0.001 on 1D_CNN/SERS_data_test caused massive overfitting: train_acc=0.979, heldout_acc=0.418, overfitting gap=59.1% \u2014 far exceeding the 7.9% gap seen with batch_norm=1. The gradient-smoothing hypothesis is validated: batch_norm is essential for stability on this 1D spectral data. Disabling batch_norm without compensating regularization (e.g., much higher dropout or weight_decay) is destructive.", "category": "regularization", "experiment_name": "1D_CNN", "_data_source": "SERS_data_test", "_manifest_name": "SERS_data_test", "_dataset_params": {}}</data>
  <data key="d8">[-0.058955000000000014, 0.0, 0.0, 0.0, 0.0]</data>
</edge>
