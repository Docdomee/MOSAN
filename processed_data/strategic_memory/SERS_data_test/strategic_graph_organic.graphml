<edge source="2D_CWT_SCALOGRAM_3d8f7b09" target="2D_CWT_SCALOGRAM_3d8f7b09" id="memorize_finding(finding=Cycle summary for 1D_CNN/2D_CWT_SCALOGR...)">
  <data key="d3">memorize_finding(finding=Cycle summary for 1D_CNN/2D_CWT_SCALOGR...)</data>
