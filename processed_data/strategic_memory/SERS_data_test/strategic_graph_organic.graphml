  <data key="d7">{"finding": "O2: run_training_trial_with_finetune on 3D_DYNAMIC_GAF/SERS_data_test using best config (lr=0.001, dropout=0.127, filters=32, num_conv_layers=6) gave shifted_test_accuracy=0.35096, which is below the 0.3814 threshold. Hypothesis that calibration finetune lifts shifted accuracy is FALSIFIED. Pretrain HO=0.9117, finetune HO=0.9128 (delta=+0.001), but shifted_test=0.3510 indicates distribution shift gap of 0.562. The 3D_DYNAMIC_GAF representation does not generalize to the shifted distribution.", "category": "hypothesis_test", "experiment_name": "3D_DYNAMIC_GAF", "_data_source": "SERS_data_test", "_manifest_name": "SERS_data_test", "_dataset_params": {"n_fft": 1024, "hop_length": 512, "gaf_image_size": 32, "video_num_segments": 1, "video_gaf_image_size": 32, "representation_type": "2D_GAF"}}</data>
