  <data key="d7">{"custom_architecture_file": "deep_slim_residual_d_cnn.py", "manifest_name": "SERS_spectral_v1", "representation_type": "1D_CNN", "dropout_rate": 0.6, "weight_decay": 0.002, "learning_rate": 0.0004, "epochs": 50, "patience": 15, "experiment_name": "deep_slim_residual_d_cnn.py", "gpu_id": 0, "_data_source": "data_paper_mine_csv", "_manifest_name": "SERS_spectral_v1", "_dataset_params": {"n_fft": 256, "hop_length": 64, "gaf_image_size": 48, "video_num_segments": 8, "video_gaf_image_size": 24, "info": "SERS bacterial classification dataset - E.coli, Enterococcus, Citrobacter. Optimized for spectral peak preservation with moderate frequency resolution."}}</data>
