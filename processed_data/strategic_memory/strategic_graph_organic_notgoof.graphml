  <data key="d7">{"custom_architecture_file": "advanced_d_cnn.py", "manifest_name": "SERS_spectral_v1", "representation_type": "1D_CNN", "num_conv_layers": 8, "filters": 160, "kernel_size": 5, "dense_units": 320, "dropout_rate": 0.75, "learning_rate": 0.0001, "weight_decay": 0.0015, "use_residual": true, "use_spectral_attention": true, "epochs": 75, "patience": 20, "save_model": false, "experiment_name": "advanced_d_cnn.py", "gpu_id": 0, "_data_source": "data_paper_mine_csv", "_manifest_name": "SERS_spectral_v1", "_dataset_params": {"n_fft": 256, "hop_length": 64, "gaf_image_size": 48, "video_num_segments": 8, "video_gaf_image_size": 24, "info": "SERS bacterial classification dataset - E.coli, Enterococcus, Citrobacter. Optimized for spectral peak preservation with moderate frequency resolution."}}</data>
